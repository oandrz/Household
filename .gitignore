.claude/settings.local.json
.DS_Store
.superpowers/
.env
api/tmp/
web/node_modules/
web/dist/

# JetBrains project files — per-developer, not per-project
.idea/

# Serena's project config, language-server index and agent memories — per-developer
# Serena keeps its cache, logs and generated memories here; only the project
# configuration is worth versioning, because it roots the language servers.
.serena/*
!.serena/project.yml

# The real production environment file. Only deploy/.env.example is tracked.
deploy/.env

# Written by deploy/deploy.sh on the box. Per-install state, not source.
deploy/.previous-image-tag

# Isolated workspaces for subagent-driven execution.
.worktrees/

# Playwright MCP walk artifacts (screenshots, page snapshots, console logs).
# Written into the repo root and web/ by a browser walk; never part of a change.
.playwright-mcp/
# make hearthctl builds here
/bin/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
