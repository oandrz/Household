.claude/settings.local.json
.DS_Store
.superpowers/
# Any environment file, at any depth: .env, .env.local, .env.bak and the like
# hold real secrets. Only the *.example templates are tracked.
.env*
!.env.example
api/tmp/
web/node_modules/
web/dist/

# JetBrains project files — per-developer, not per-project
.idea/

# Serena's project config, language-server index and agent memories — per-developer
# Serena keeps its cache, logs and generated memories here; only the project
# configuration is worth versioning, because it roots the language servers.
.serena/*
!.serena/project.yml

# The real production environment file. Only deploy/.env.example is tracked.
deploy/.env

# Written by deploy/deploy.sh on the box. Per-install state, not source.
deploy/.previous-image-tag

# Isolated workspaces for subagent-driven execution.
.worktrees/

# Playwright MCP walk artifacts (screenshots, page snapshots, console logs).
# Written into the repo root and web/ by a browser walk; never part of a change.
.playwright-mcp/
# make hearthctl builds here
/bin/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# `go build` run inside api/ or api/cmd/hearthctl/ drops its binary next to the
# source. Two were committed by accident (#22); `make hearthctl` builds to /bin/.
/api/api
/api/cmd/hearthctl/hearthctl

# Screenshots shared with an agent while working. They can show account names,
# IP addresses and control panels, and this repository is public.
.claude/communicate/

# Review write-ups name unfixed weaknesses by file, and this repository is
# public, so new ones stay local. A file already tracked here stays tracked.
docs/reviews/
