# Copy to deploy/.env on the box and fill in. `chmod 600` it. Never commit it.
#
# Compose reads THIS file for two different jobs and the difference matters:
# `${VAR}` interpolation in docker-compose.prod.yml only ever reads a file
# literally named `.env` in the directory Compose runs from -- which is why
# the real file is `.env` and not `.env.production`. The same file is also
# passed to containers via `env_file:`.

# --- what to run -----------------------------------------------------------
# The git SHA CI tagged the images with. Changing this value is what a deploy
# IS. It must never be `latest`: a migration-only change produces a
# byte-identical api image, and without a changed tag Compose will not recreate
# `api`, will not re-evaluate depends_on: migrate, and the migration silently
# does not run.
IMAGE_TAG=

# --- the box ---------------------------------------------------------------
# The hostname Caddy requests a certificate for. It must already resolve to
# this box before `up`, or the ACME challenge fails. A free DDNS hostname works
# here: Caddy uses the HTTP-01 challenge over port 80, which needs no DNS TXT
# record at all -- that restriction only bites on mail (see SMTP_ADDR below).
DOMAIN=oink.mywire.org
ACME_EMAIL=you@example.com

# --- application (every variable config.Load() requires) -------------------
APP_ENV=production
PORT=8080
# sslmode=disable is correct and deliberate: postgres is on the private compose
# bridge and is never published, so this connection does not cross a network.
# See the spec's decision 9.
DATABASE_URL=postgres://hearth:CHANGEME@postgres:5432/hearth?sslmode=disable
# Must be the public HTTPS origin, exactly. It is composed into every magic
# link, invite and sign-up link, and it is the origin the session and CSRF
# cookies are scoped to. A wrong value fails at no startup and in no test -- it
# just mails broken links.
APP_BASE_URL=https://oink.mywire.org
# Mail stays on the box. See docs/adr/0003-mail-stays-on-the-box.md: a hosted
# relay needs a domain whose DNS accepts TXT records for DKIM, and this
# install's free DDNS hostname does not. `mailpit` is a real service in
# docker-compose.prod.yml; read the inbox through an SSH tunnel.
#
# WHEN A REAL DOMAIN ARRIVES, four lines change together and none alone:
#   SMTP_ADDR=smtp.resend.com:587
#   SMTP_USERNAME=resend            (and SMTP_PASSWORD=<the API key>)
#   SMTP_FROM="Hearth <noreply@your-domain>"
#   SMTP_TLS_MODE=                  (unset it, so it defaults to mandatory)
# and the mailpit service comes out of the compose file.
SMTP_ADDR=mailpit:1025
SMTP_FROM="Hearth <noreply@oink.mywire.org>"
# SMTP_USERNAME and SMTP_PASSWORD: set BOTH together (Resend's SMTP username is
# literally "resend"; the password is the API key) or leave BOTH blank.
# config.Load() refuses one set and the other empty, and it runs before every
# adminctl subcommand too -- so a lone leftover value here does not just
# affect mail, it breaks unlock-household, reset-password, create-invite and
# prune as well, with an error that says nothing about any of them. Blank is
# the safe starting value for exactly that reason: it cannot produce this trap
# by omission the way a pre-filled username with no password can.
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_TLS_MODE must be set explicitly HERE, and only because mail is on the
# box. It defaults to "mandatory" whenever APP_ENV is not development, which is
# right for a hosted relay and wrong for Mailpit, which speaks plain SMTP on
# the compose network. Left at the default, every send fails -- silently,
# because the send is fire-and-forget. Delete this line the day SMTP_ADDR
# points at a real relay; leaving it behind would downgrade a real connection.
SMTP_TLS_MODE=none
ARGON2_TIME=3
ARGON2_MEMORY_KIB=65536
ARGON2_THREADS=2
# TELEGRAM_BOT_TOKEN and TELEGRAM_BOT_USERNAME turn Telegram sign-in on, and on
# this box they are what make sign-up actually work: mail stays on the box (see
# above), so an email sign-up link is minted and never delivered to a real
# inbox. Telegram is the channel that reaches the person until a real domain
# and hosted relay arrive. Both or neither -- config.Load refuses one without
# the other, and that check runs before every adminctl subcommand too, so a
# lone leftover value here breaks unlock-household and reset-password as well
# as mail.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_BOT_USERNAME=

# --- postgres --------------------------------------------------------------
# Must match the password inside DATABASE_URL above.
POSTGRES_PASSWORD=CHANGEME

# --- migrations ------------------------------------------------------------
# goose takes its DSN from the environment rather than from an argument,
# because the admin image has no shell and an exec-form command cannot expand
# ${DATABASE_URL}. Same value as DATABASE_URL; kept as its own variable so the
# migrate service needs no interpolation of a secret into the compose config.
GOOSE_DBSTRING=postgres://hearth:CHANGEME@postgres:5432/hearth?sslmode=disable
