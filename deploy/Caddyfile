{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Caddy REPLACES X-Forwarded-For with the address it is actually talking
	# to, rather than appending to whatever the caller sent: it preserves a
	# caller's list only when that caller is itself listed in this proxy's
	# trusted_proxies, and none is configured here. So a client's own
	# X-Forwarded-For never reaches nginx, and the set_real_ip_from in
	# web/nginx.conf resolves against exactly one address -- the real peer.
	# Adding trusted_proxies here (fronting this with Cloudflare is the usual
	# reason) is what would change that, and nginx's `real_ip_recursive off`
	# is the guard for that day. Verified by reading nginx's logged
	# $http_x_forwarded_for, not by trusting this note.
	reverse_proxy web:80
}
