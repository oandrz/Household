# Copy to /home/deploy/hearth-backup.env on the box and `chmod 600` it.
# The nightly cron sources this file. Never commit the real one.
#
# These live in a file rather than inline in the crontab because a crontab is
# readable by anyone who can run `crontab -l` as this user, and HC_PING_URL is
# a capability: whoever holds it can ping it, which suppresses the "your backup
# stopped" alert. A backup that has silently stopped with its alarm disabled is
# exactly the failure the heartbeat exists to catch.

# The PUBLIC half of the age keypair -- `age-keygen -y ~/.config/age/hearth.key`
# run on the OPERATOR'S machine. The private key must never be on this box: a
# box that can decrypt its own backups hands an attacker both halves at once.
AGE_RECIPIENT=age1...

# rclone remote and bucket. See PROVISION.md for configuring the remote.
RCLONE_REMOTE=r2:hearth-backups

# healthchecks.io ping URL. backup.sh pings it ONLY after a successful upload,
# so a missed ping means a missed backup. This is the only thing standing
# between "backups stopped in March" and "we found out in March".
HC_PING_URL=

# A SECOND healthchecks.io check, for the disk alarm (disk-check.sh). Period
# 15 minutes, grace 30. It is pinged as healthy while the disk is under
# DISK_ALARM_PERCENT and failed once it is over, so the owner is mailed
# before the database runs out of room. Separate from HC_PING_URL: one check
# per question.
HC_DISK_PING_URL=
# Percent of the disk in use that sets the alarm off. 80 leaves about 8 GB of
# a 40 GB disk to act in.
DISK_ALARM_PERCENT=80
